# Copy this file to .env and replace every change-me value with a unique local secret.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/marketpulse

# Optional for local setup. Create OAuth credentials in Google Cloud before enabling sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Optional for local setup. Use Alpaca paper-trading credentials, never production keys.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Generate separate random values of at least 32 characters. Do not reuse these examples.
ACCESS_TOKEN_SECRET=change-me-generate-a-random-value
REFRESH_TOKEN_PEPPER=change-me-generate-another-random-value
