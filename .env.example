# Copy this file to .env. Values are intentionally blank; never commit credentials.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/marketpulse?replicaSet=rs0

# Optional for local setup. Create OAuth credentials in Google Cloud before enabling sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional for local setup. Use Alpaca paper-trading credentials, never production keys.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Generate separate random values of at least 32 characters.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
